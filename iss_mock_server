#!/usr/bin/env python3
"""
iss_mock_server — Standalone ISS Equipment Mock HTTP Server
Engineering Use ONLY. Not included in official production releases.

Starts a persistent local mock PDU: the APC NMC CLI over SSH, the WTI REST
API, or the Raritan JSON-RPC API over HTTP. Use this to develop against a real-looking endpoint without
any physical hardware — with curl, scripts, or iss_pdu_utility.
"""

import argparse
import signal
import sys
import time

import equipment_drivers  # noqa: trigger auto-import of all drivers
from equipment_drivers.simulator import MockPduServer

BOLD = "\033[1m"
CYAN = "\033[96m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RESET = "\033[0m"

SUPPORTED_VENDORS = ["apc", "wti", "raritan"]

VENDOR_ENDPOINTS = {
    "apc": [
        ("SSH", "olStatus <ch|all>",                 "Outlet status, e.g. 'E000: Success' + ' 1: Outlet 1: On'"),
        ("SSH", "olOn <ch> / olOff <ch>",            "Switch outlet(s); <ch> may be 3, 1,3 or 1-4"),
    ],
    "wti": [
        ("GET",  "/api/v2/status/status",            "Unit identity (vendor, product, totalplugs)"),
        ("GET",  "/api/v2/config/powerplug[?plug=N]", "Plug state(s)"),
        ("POST", "/api/v2/config/powerplug",         'Set plug: {"plug": "1", "state": "on"|"off"|"boot"}'),
    ],
    "raritan": [
        ("POST", "/model/pdu/0",                     "JSON-RPC getMetaData, getOutlets"),
        ("POST", "/model/pdu/0/outlet/<idx>",        "JSON-RPC getState, setPowerState {pstate: 0|1} (idx = channel - 1)"),
    ],
}


def print_banner(vendor: str, host: str, port: int, channels: int):
    scheme = "ssh" if vendor == "apc" else "http"
    print(f"{BOLD}")
    print("=" * 72)
    print(f"  ISS Mock Equipment Server — {vendor.upper()} PDU Simulator")
    print(f"  [ENGINEERING USE ONLY — Not included in official package]")
    print("=" * 72)
    print(f"{RESET}")
    print(f"  {BOLD}Listening:{RESET}   {scheme}://{host}:{port}")
    print(f"  {BOLD}Vendor:{RESET}      {vendor.upper()}")
    print(f"  {BOLD}Channels:{RESET}    {channels}")
    print()
    print(f"  {BOLD}{CYAN}Available {'CLI commands' if vendor == 'apc' else 'API endpoints'}:{RESET}")
    for method, endpoint, desc in VENDOR_ENDPOINTS.get(vendor, []):
        print(f"    [{method:4s}] {endpoint:<38} {desc}")
    print()
    print(f"  {BOLD}Examples:{RESET}")
    if vendor == "apc":
        print(f"    ssh -p {port} apc@{host}          # any password; then type: olStatus all")
    elif vendor == "wti":
        print(f"    curl http://{host}:{port}/api/v2/status/status")
        print(f"    curl 'http://{host}:{port}/api/v2/config/powerplug?plug=1'")
        print("    curl -X POST -H 'Content-Type: application/json' \\")
        print(f'         -d \'{{"plug":"1","state":"off"}}\' http://{host}:{port}/api/v2/config/powerplug')
    elif vendor == "raritan":
        print(f"    curl -d '{{\"jsonrpc\":\"2.0\",\"method\":\"getMetaData\",\"id\":1}}' http://{host}:{port}/model/pdu/0")
        print(f"    curl -d '{{\"jsonrpc\":\"2.0\",\"method\":\"getState\",\"id\":2}}' http://{host}:{port}/model/pdu/0/outlet/0")
        print("    curl -d '{{\"jsonrpc\":\"2.0\",\"method\":\"setPowerState\",\"params\":{{\"pstate\":0}},\"id\":3}}' \\")
        print(f"         http://{host}:{port}/model/pdu/0/outlet/0")

    print()
    print(f"  {YELLOW}Press Ctrl+C to stop the server.{RESET}")
    print()


def main():
    parser = argparse.ArgumentParser(
        description="ISS Equipment Mock HTTP Server [Engineering Use Only]")
    parser.add_argument(
        "--vendor", choices=SUPPORTED_VENDORS, required=True,
        help="Vendor to simulate: apc, wti, or raritan")
    parser.add_argument(
        "--port", type=int, default=None,
        help="Port to listen on (default: 2222 for apc, 8080 otherwise; 0 picks a free port)")
    parser.add_argument(
        "--channels", type=int, default=None,
        help="Number of simulated outlets/channels (default: vendor-specific default)")
    args = parser.parse_args()

    # Default channel counts per vendor
    default_channels = {"apc": 8, "wti": 20, "raritan": 24}
    channels = args.channels or default_channels.get(args.vendor, 8)

    port = args.port if args.port is not None else (2222 if args.vendor == "apc" else 8080)
    server = MockPduServer(vendor=args.vendor, channel_count=channels, port=port)

    def shutdown(sig, frame):
        print(f"\n{BOLD}Shutting down mock server...{RESET}")
        server.stop()
        sys.exit(0)

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    server.start()
    print_banner(args.vendor, server.host, server.port, channels)

    # Keep alive until Ctrl+C
    while True:
        time.sleep(1)


if __name__ == "__main__":
    main()
