#!/usr/bin/env python3
"""
iss_trial_utility — ISS Equipment Blackbox Trial & Diagnostic Tool
Engineering Use ONLY. Not included in official production releases.

Run 9-phase offline mock trials against any supported PDU model to
verify driver behaviour, inspect RAW_OUTPUT payloads, and validate
channel boundary enforcement — with zero real hardware required.
"""

import argparse
import sys

import equipment_drivers  # noqa: trigger auto-import of all drivers
from equipment_drivers.registry import registry
from equipment_drivers.simulator import run_pdu_blackbox_trial, run_pdu_fault_trial, run_pdu_mock_action

BOLD = "\033[1m"
CYAN = "\033[96m"
GREEN = "\033[92m"
RED = "\033[91m"
YELLOW = "\033[93m"
RESET = "\033[0m"

HEADER = f"""{BOLD}
========================================================================
  ISS Equipment Blackbox Trial & Diagnostic Tool
  Interactive & Automated Hardware Model Verification
  [ENGINEERING USE ONLY — Not included in official package]
========================================================================
{RESET}"""


def list_all_models():
    print(HEADER)
    print(f"{BOLD}Supported PDU Models:{RESET}\n")
    all_drivers = dict(registry.get_all_drivers("pdu"))
    vendors: dict = {}
    for sig, cls in sorted(all_drivers.items()):
        if sig.startswith("dummy"):
            continue
        vendor = sig.split("_")[0].upper()
        vendors.setdefault(vendor, []).append((sig, cls))

    for vendor, entries in sorted(vendors.items()):
        print(f"  {BOLD}{CYAN}{vendor}{RESET} ({len(entries)} models)")
        for sig, cls in entries:
            inst = cls()
            print(f"    {sig:<30}  {inst.get_model():<40}  (max {inst.get_max_channel()} ch)")
        print()


def run_vendor(vendor_name: str, trial=run_pdu_blackbox_trial) -> bool:
    all_drivers = dict(registry.get_all_drivers("pdu"))
    matches = {sig: cls for sig, cls in all_drivers.items()
               if sig.startswith(vendor_name.lower() + "_")}
    if not matches:
        print(f"{RED}No models found for vendor '{vendor_name}'.{RESET}")
        return False

    results = {}
    for sig, cls in sorted(matches.items()):
        passed = trial(sig, cls, verbose=True)
        results[sig] = passed

    total = len(results)
    ok = sum(1 for v in results.values() if v)
    print(f"\n{BOLD}========== Vendor '{vendor_name.upper()}' Summary ==========")
    print(f"  Passed: {GREEN}{ok}{RESET} / {total}")
    if ok < total:
        print(f"  {RED}Failed:{RESET} {total - ok}")
        for sig, passed in results.items():
            if not passed:
                print(f"    - {sig}")
    print(f"======================================================{RESET}\n")
    return ok == total


def run_all(trial=run_pdu_blackbox_trial) -> bool:
    all_drivers = dict(registry.get_all_drivers("pdu"))
    sigs = [(sig, cls) for sig, cls in sorted(all_drivers.items()) if not sig.startswith("dummy")]
    results = {}
    for sig, cls in sigs:
        passed = trial(sig, cls, verbose=True)
        results[sig] = passed

    total = len(results)
    ok = sum(1 for v in results.values() if v)
    print(f"\n{BOLD}========== Full Catalog Summary ==========")
    print(f"  Total Drivers Tested: {total}")
    print(f"  Passed: {GREEN}{ok}{RESET} / {total}")
    if ok < total:
        print(f"  {RED}Failed: {total - ok}{RESET}")
        for sig, passed in results.items():
            if not passed:
                print(f"    - {sig}")
    print(f"==========================================={RESET}\n")
    return ok == total


def interactive_menu():
    print(HEADER)
    all_drivers = dict(registry.get_all_drivers("pdu"))
    sigs = sorted([sig for sig in all_drivers if not sig.startswith("dummy")])
    vendors = sorted(set(sig.split("_")[0].upper() for sig in sigs))

    while True:
        print(f"\n{BOLD}Main Menu:{RESET}")
        print("  [1] List all models")
        print("  [2] Trial a specific model")
        print("  [3] Trial all models for a vendor")
        print("  [4] Trial ALL models")
        print("  [5] Run single action on a model")
        print("  [q] Quit")

        choice = input("\nEnter choice: ").strip().lower()

        if choice == "q":
            print("Goodbye.")
            break
        elif choice == "1":
            list_all_models()
        elif choice == "2":
            print(f"\nAvailable signatures (sample): {', '.join(sigs[:6])}, ...")
            sig = input("Enter driver signature: ").strip()
            cls = registry.get_driver("pdu", sig)
            if not cls:
                print(f"{RED}Unknown signature '{sig}'. Use option 1 to list all.{RESET}")
            else:
                run_pdu_blackbox_trial(sig, cls)
        elif choice == "3":
            print(f"\nAvailable vendors: {', '.join(vendors)}")
            vendor = input("Enter vendor name: ").strip()
            run_vendor(vendor)
        elif choice == "4":
            run_all()
        elif choice == "5":
            print(f"\nAvailable signatures (sample): {', '.join(sigs[:6])}, ...")
            sig = input("Enter driver signature: ").strip()
            cls = registry.get_driver("pdu", sig)
            if not cls:
                print(f"{RED}Unknown signature '{sig}'.{RESET}")
            else:
                action = input("Enter action (on/off/status): ").strip()
                ch = input("Enter channel spec (e.g. 1, 1-3, all): ").strip()
                run_pdu_mock_action(sig, cls, action, ch)
        else:
            print(f"{YELLOW}Invalid choice.{RESET}")


def main():
    parser = argparse.ArgumentParser(
        description="ISS Equipment Blackbox Trial & Diagnostic Tool [Engineering Use Only]")
    parser.add_argument("--list", action="store_true", help="List all supported driver signatures")
    parser.add_argument("--model", type=str, help="Driver signature to trial (e.g. apc_ap7900)")
    parser.add_argument("--vendor", type=str, help="Trial all models for a vendor (apc, wti, raritan)")
    parser.add_argument("--all", action="store_true", help="Trial all registered models")
    parser.add_argument("--faults", action="store_true",
                        help="With --model/--vendor/--all: run the fault trial (auth failure, timeout, dropped "
                             "connection, command error, stuck outlet) instead of the 9-step trial")
    parser.add_argument("--action", choices=["on", "off", "status"],
                        help="Run a single action instead of a full trial")
    parser.add_argument("--channel", type=str, default="1",
                        help="Channel spec for --action (e.g. 1, 1-3, all). Default: 1")

    args = parser.parse_args()

    # Default: interactive menu when no args given
    if len(sys.argv) == 1:
        interactive_menu()
        return

    if args.list:
        list_all_models()
        return

    trial = run_pdu_fault_trial if args.faults else run_pdu_blackbox_trial

    if args.all:
        ok = run_all(trial)
        sys.exit(0 if ok else 1)

    if args.vendor:
        ok = run_vendor(args.vendor, trial)
        sys.exit(0 if ok else 1)

    if args.model:
        cls = registry.get_driver("pdu", args.model)
        if not cls:
            print(f"{RED}Unknown model signature '{args.model}'. Use --list to see all.{RESET}")
            sys.exit(1)

        if args.action:
            ok = run_pdu_mock_action(args.model, cls, args.action, args.channel)
        else:
            ok = trial(args.model, cls)

        sys.exit(0 if ok else 1)

    parser.print_help()


if __name__ == "__main__":
    main()
